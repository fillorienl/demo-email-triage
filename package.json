{
  "name": "email-triage-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fillorie demo: AI customer-service email triage for a fictional Dutch wholesaler",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply triage-demo --local",
    "db:migrate:remote": "wrangler d1 migrations apply triage-demo --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "postal-mime": "4.0.11",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.2"
  },
  "allowScripts": {
    "workerd@1.20261012.1": true,
    "workerd@1.20261019.1": true,
    "esbuild@0.28.2": true
  }
}
