{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "triage-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Public only on the custom domain; the workers.dev URL stays off so /admin can't be reached around Access.
  "workers_dev": false,
  "routes": [{ "pattern": "triage.fillorie.nl", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "triage-demo",
      // Fill in after: npx wrangler d1 create triage-demo --jurisdiction eu
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "AI_MODE": "live",
    "LLM_PROVIDER": "anthropic",
    "ANTHROPIC_MODEL": "claude-haiku-5-5",
    "MISTRAL_MODEL": "mistral-medium-latest",
    "TURNSTILE_SITE_KEY": "",
    "CAP_SANDBOX_LIVE_PER_DAY": "20",
    "CAP_GLOBAL_AI_CALLS_PER_DAY": "300",
    "RETENTION_DAYS": "7",
    "INBOUND_ADDRESS": "service@fillorie.nl",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
